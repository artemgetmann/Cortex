# Local worktree checkouts live here; keep them out of `git status`.
.worktrees/
.worktree/
.vm/

# Parallels VM bundles (large, local-only)
*.pvm
*.macvm

# Local assistant config (machine/user-specific).
.claude/

# macOS noise
.DS_Store
._*

# Common secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

