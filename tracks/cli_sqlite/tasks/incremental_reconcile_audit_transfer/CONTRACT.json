{
  "id": "cli-sqlite-incremental-reconcile-audit-transfer-v1",
  "task_match": {
    "all": [
      "sqlite"
    ],
    "any": [
      "reconcile",
      "audit",
      "dedupe"
    ]
  },
  "setup": {
    "bootstrap_sql_path": "bootstrap.sql",
    "fixture_paths": [
      "fixture.csv"
    ]
  },
  "signals": {
    "required_sql_patterns": [
      "(?is)begin\\s+(transaction|immediate)",
      "(?is)commit",
      "(?is)insert\\s+into\\s+ledger",
      "(?is)insert\\s+into\\s+rejects",
      "(?is)insert\\s+(or\\s+replace\\s+into|into)\\s+batch_audit",
      "(?is)duplicate_event",
      "(?is)invalid_amount",
      "(?is)batch-may-01"
    ],
    "forbidden_sql_patterns": [
      "(?is)drop\\s+table\\s+ledger",
      "(?is)delete\\s+from\\s+ledger",
      "(?is)delete\\s+from\\s+rejects"
    ],
    "required_queries": [
      {
        "id": "ledger_aggregate",
        "sql": "SELECT category, SUM(amount) AS total FROM ledger GROUP BY category ORDER BY category;",
        "expected_rows": [
          [
            "bass",
            "4"
          ],
          [
            "drums",
            "13"
          ],
          [
            "lead",
            "3"
          ]
        ]
      },
      {
        "id": "reject_breakdown",
        "sql": "SELECT reason, COUNT(*) FROM rejects GROUP BY reason ORDER BY reason;",
        "expected_rows": [
          [
            "duplicate_event",
            "1"
          ],
          [
            "invalid_amount",
            "1"
          ]
        ]
      },
      {
        "id": "batch_audit_row",
        "sql": "SELECT batch_tag, accepted_count, rejected_count FROM batch_audit ORDER BY batch_tag;",
        "expected_rows": [
          [
            "BATCH-MAY-01",
            "4",
            "2"
          ]
        ]
      }
    ],
    "max_error_count": 1
  },
  "pass_rule": "all_required && no_forbidden && required_queries_match && errors_within_budget",
  "reason_codes": [
    "missing_required_pattern",
    "matched_forbidden_pattern",
    "required_query_mismatch",
    "too_many_errors"
  ]
}
