{
  "id": "cli-sqlite-partial-failure-recovery-strict-v1",
  "task_match": {
    "all": [
      "sqlite"
    ],
    "any": [
      "partial",
      "failure",
      "recovery",
      "strict"
    ]
  },
  "setup": {
    "bootstrap_sql_path": "bootstrap.sql",
    "fixture_paths": [
      "fixture.csv"
    ]
  },
  "signals": {
    "required_sql_patterns": [
      "(?is)begin\\s+(transaction|immediate)",
      "(?is)commit",
      "(?is)insert\\s+into\\s+transactions",
      "(?is)insert\\s+into\\s+error_log",
      "(?is)invalid_amount"
    ],
    "forbidden_sql_patterns": [
      "(?is)drop\\s+table\\s+transactions",
      "(?is)drop\\s+table\\s+error_log",
      "(?is)delete\\s+from\\s+transactions",
      "(?is)delete\\s+from\\s+error_log"
    ],
    "required_queries": [
      {
        "id": "valid_txn_count",
        "sql": "SELECT COUNT(*) FROM transactions;",
        "expected_rows": [
          [
            "4"
          ]
        ]
      },
      {
        "id": "error_count",
        "sql": "SELECT COUNT(*) FROM error_log;",
        "expected_rows": [
          [
            "2"
          ]
        ]
      },
      {
        "id": "error_ids",
        "sql": "SELECT txn_id, reason FROM error_log ORDER BY txn_id;",
        "expected_rows": [
          [
            "T003",
            "invalid_amount"
          ],
          [
            "T005",
            "invalid_amount"
          ]
        ]
      },
      {
        "id": "txn_totals",
        "sql": "SELECT account, SUM(amount) AS total FROM transactions GROUP BY account ORDER BY account;",
        "expected_rows": [
          [
            "checking",
            "650"
          ],
          [
            "savings",
            "500"
          ]
        ]
      }
    ],
    "max_error_count": 1
  },
  "pass_rule": "all_required && no_forbidden && required_queries_match && errors_within_budget",
  "reason_codes": [
    "missing_required_pattern",
    "matched_forbidden_pattern",
    "required_query_mismatch",
    "too_many_errors"
  ]
}
