# Claude Telegram Bot - Environment Configuration

# ==============================================================================
# REQUIRED
# ==============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user IDs allowed to use the bot
# Find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=123456789

# ==============================================================================
# RECOMMENDED
# ==============================================================================

# Working directory where the assistant runs (loads CLAUDE.md, skills, MCP config)
# Backward-compatible alias: CLAUDE_WORKING_DIR
AI_WORKING_DIR=/Users/yourname/claude-code-telegram-bot/workspace

# OpenAI API key for voice message transcription
# Without this, voice messages won't work
OPENAI_API_KEY=sk-...

# Assistant selection: claude | codex
# Default is claude
AI_ASSISTANT=claude

# Default model ids used at startup (switch anytime with /model in Telegram)
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_REASONING_EFFORT=high
CODEX_MODEL=gpt-5.3-codex
# Codex reasoning effort: minimal | low | medium | high | xhigh
CODEX_REASONING_EFFORT=medium
# Codex execution policy (sandboxed defaults)
CODEX_SANDBOX_MODE=workspace-write          # read-only | workspace-write | danger-full-access
CODEX_APPROVAL_POLICY=on-request            # never | on-request | on-failure | untrusted
CODEX_NETWORK_ACCESS_ENABLED=true
CODEX_WEB_SEARCH_MODE=live                  # disabled | cached | live

# ==============================================================================
# OPTIONAL - Security
# ==============================================================================

# Comma-separated paths assistants can access
# Default: working dir, ~/Programming_Projects, ~/.claude, ~/.codex
# ALLOWED_PATHS fully overrides defaults
# ALLOWED_PATHS=/Users/yourname/personal,/Users/yourname/projects,/Users/yourname/.claude,/Users/yourname/.codex
# ALLOWED_PATHS_EXTRA appends paths to default/override
# ALLOWED_PATHS_EXTRA=/Users/yourname/Documents
# ALLOWED_PATHS_REMOVE removes paths from default/override+extra
# ALLOWED_PATHS_REMOVE=/Users/yourname/Programming_Projects

# Rate limiting (token bucket)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW=60

# ==============================================================================
# OPTIONAL - Claude Authentication
# ==============================================================================

# API key for environments without Claude Code CLI auth
# Get from: https://console.anthropic.com/
# Note: API usage is billed per token - CLI auth is more cost-effective
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Path to Claude CLI (auto-detected from PATH by default)
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# Enable native Claude Code Chrome integration (--chrome)
# Requires Claude Code + Claude in Chrome extension set up locally
# CLAUDE_ENABLE_CHROME=true

# ==============================================================================
# OPTIONAL - Codex Authentication
# ==============================================================================

# For Codex mode (AI_ASSISTANT=codex), authenticate once on this machine:
#   codex login
# This creates ~/.codex/auth.json used by @openai/codex-sdk.

# ==============================================================================
# OPTIONAL - Extended Thinking
# ==============================================================================

# Keywords that trigger extended thinking (comma-separated, case-insensitive)
# THINKING_KEYWORDS=think,pensa,ragiona

# Keywords that trigger deep thinking (50k tokens)
# THINKING_DEEP_KEYWORDS=ultrathink,think hard,pensa bene

# ==============================================================================
# OPTIONAL - Voice Transcription
# ==============================================================================

# Path to a text file with additional context for voice transcription
# (names, technical terms, etc. — keeps personal context outside this repo)
# TRANSCRIPTION_CONTEXT_FILE=/path/to/transcription-context.txt

# ==============================================================================
# OPTIONAL - Runtime Paths
# ==============================================================================

# Runtime directory for session/audit/temp files
# Backward-compatible alias: CLAUDE_RUNTIME_DIR
# Default: <AI_WORKING_DIR>/sessions
# AI_RUNTIME_DIR=/Users/yourname/claude-code-telegram-bot/workspace/sessions

# Optional overrides if you need custom file locations
# AI_TEMP_DIR=<AI_RUNTIME_DIR>/telegram-bot
# AI_SESSION_FILE=<AI_RUNTIME_DIR>/claude-telegram-session.json
# AI_RESTART_FILE=<AI_RUNTIME_DIR>/claude-telegram-restart.json

# ==============================================================================
# OPTIONAL - Cortex Brain Bridge (Enabled by default in AGI bot)
# ==============================================================================

# Toggle Cortex bridge routing for task-mode requests.
# CORTEX_BRIDGE_ENABLED=true

# Dynamic path mode (default on): when enabled, startup auto-binds
# CORTEX_ROOT / CORTEX_DISPATCHER_PATH / AI_WORKING_DIR to the current
# checkout (repo/worktree) that launched the service.
# Set to 0 only if you intentionally want pinned static paths below.
# CORTEX_DYNAMIC_PATHS=1

# Cortex repo root (single source of truth for learning logic)
# CORTEX_ROOT=/Users/yourname/Programming_Projects/Cortex

# Dispatcher path used to run execute->judge->lesson loop
# CORTEX_DISPATCHER_PATH=/Users/yourname/Programming_Projects/Cortex/integrations/cortex_dispatch.py

# Dispatch runtime profile:
# - v15: locked OpenAI + GPT-5 nano execution path (recommended)
# - legacy: previous configurable path
# CORTEX_DISPATCH_PROFILE=v15

# Isolated runtime lane for Cortex sessions/lessons generated via Telegram.
# This prevents Telegram memory from contaminating benchmark/programmatic runs.
# CORTEX_RUNTIME_LANE=telegram

# Timeout for one Cortex run (ms)
# CORTEX_BRIDGE_TIMEOUT_MS=420000

# Auto-detect task-like plain messages (non-/run)
# CORTEX_AUTO_TASK_ROUTING=true

# Ask confirmation before task-mode execution
# Set false for zero-friction natural-language task routing.
# CORTEX_CONFIRMATION_ENABLED=false

# Default domain for auto-routed tasks
# CORTEX_TASK_DEFAULT_DOMAIN=shell

# ==============================================================================
# OPTIONAL - Logging
# ==============================================================================

# Streaming diagnostics and tuning
# STREAMING_DEBUG=true
# STREAMING_THROTTLE_MS=250
# STREAMING_SYNTHETIC_FALLBACK_MIN_CHARS=280
# STREAMING_SYNTHETIC_STEP_CHARS=220
# STREAMING_SYNTHETIC_STEP_DELAY_MS=80

# Audit log path
# Default: <AI_RUNTIME_DIR>/claude-telegram-audit.log
# AUDIT_LOG_PATH=<AI_RUNTIME_DIR>/claude-telegram-audit.log

# Output audit logs as JSON (default: human-readable)
# AUDIT_LOG_JSON=false
